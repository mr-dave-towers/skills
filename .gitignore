# ==========================
# SECRETS — never let an agent read these
# ==========================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*credentials*.json
*serviceaccount*.json
.aws/
.gcloud/
.ssh/
secrets/

# ==========================
# DEPENDENCIES & BUILD ARTIFACTS
# ==========================
node_modules/
dist/
build/
.next/
target/
vendor/
*.min.js
*.map
*.tsbuildinfo

# ==========================
# TEST & COVERAGE NOISE
# ==========================
coverage/
test-results/
playwright-report/
*.log
npm-debug.log*
logs/

# ==========================
# EDITOR / OS CLUTTER
# ==========================
.DS_Store
.idea/
.vscode/
*.swp

# ==========================
# AI-SPECIFIC (mirror into .cursorignore too)
# ==========================
*.tfstate
*.dump
*.sqlite
fixtures/large/
